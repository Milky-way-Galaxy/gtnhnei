{
  "name": "gtnh-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "lint": "eslint .",
    "check": "node tools/check-site.js",
    "build": "npm run check && npm run check:flow && npm run check:offline",
    "verify": "npm run lint && npm run build && npm test && npm run test:browser",
    "check:flow": "python3 tools/package-flow.py --check",
    "audit:data": "node tools/audit-data.js",
    "smoke:flow": "node tools/smoke-flow.js",
    "check:machines": "python3 tools/machine-reference.py",
    "offline:manifest": "node tools/offline-manifest.js --write",
    "check:offline": "node tools/offline-manifest.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "^10.13.0",
    "globals": "^16.5.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
